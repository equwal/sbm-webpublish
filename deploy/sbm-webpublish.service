# systemd unit for sbm-webpublish. deploy.sh installs it as
# /etc/systemd/system/sbm-webpublish.service. /etc/sbm-webpublish.env
# (mode 600) holds ADMIN_PASSWORD=...
[Unit]
Description=sbm-webpublish: links from an sbm bookmark file
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/sbm-webpublish.env
Environment=LINKS_FILE=/var/lib/sbm-webpublish/links.sbm
ExecStart=/usr/local/bin/sbm-webpublish
DynamicUser=yes
StateDirectory=sbm-webpublish
ProtectSystem=strict
ProtectHome=yes
NoNewPrivileges=yes
Restart=on-failure

[Install]
WantedBy=multi-user.target
